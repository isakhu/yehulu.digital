{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/auth/login",
      "destination": "/api/auth/login.js"
    },
    {
      "source": "/api/auth/me",
      "destination": "/api/auth/me.js"
    },
    {
      "source": "/api/auth/logout",
      "destination": "/api/auth/logout.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?__route=/api/$1"
    },
    {
      "source": "/client-portal",
      "destination": "/client-portal.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/gallery",
      "destination": "/index.html"
    },
    {
      "source": "/video",
      "destination": "/index.html"
    },
    {
      "source": "/courses",
      "destination": "/index.html"
    },
    {
      "source": "/courses/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/services",
      "destination": "/services.html"
    },
    {
      "source": "/estimate",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/about.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/",
      "permanent": true
    }
  ]
}
