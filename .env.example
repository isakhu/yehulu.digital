# Safe environment-variable template. Never commit real secrets here.
# For Vercel, add the real values in Project Settings > Environment Variables.
ADMIN_PASSWORD=
SESSION_SECRET=

# Optional legacy fallback for an existing scrypt-hashed admin password.
# Prefer ADMIN_PASSWORD for the simple, password-only owner login.
ADMIN_PASSWORD_HASH=

# Public Blob store token for uploaded portfolio media.
BLOB_READ_WRITE_TOKEN=

# Optional static token for PRIVATE CMS Blob storage when not using Vercel OIDC.
CMS_BLOB_READ_WRITE_TOKEN=

# Vercel creates this store ID automatically when the private CMS store is connected with OIDC.
# Do not commit any OIDC token or store credentials.
CMS_BLOB_STORE_ID=
